{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.27.0",
        "@bull-board/api": "^5.21.0",
        "@bull-board/fastify": "^5.21.0",
        "@clerk/backend": "^1.5.0",
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/swagger": "^8.15.0",
        "@fastify/swagger-ui": "^4.0.1",
        "@leadflow/types": "workspace:*",
        "bullmq": "^5.12.0",
        "date-fns": "^3.6.0",
        "date-fns-tz": "^3.1.3",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.32.0",
        "fastify": "^4.28.0",
        "ioredis": "^5.4.1",
        "openai": "^4.55.0",
        "pg": "^8.12.0",
        "resend": "^4.0.0",
        "svix": "^1.24.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/pg": "^8.11.6",
        "drizzle-kit": "^0.23.0",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.16.0",
        "typescript": "^5.5.0"
    }
