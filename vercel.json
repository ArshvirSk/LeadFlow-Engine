{
    "framework": "nextjs",
    "buildCommand": "pnpm --filter @leadflow/web build",
    "outputDirectory": "packages/web/.next",
    "installCommand": "pnpm install --frozen-lockfile",
    "devCommand": "pnpm --filter @leadflow/web dev",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://leadflow-api.onrender.com/api/:path*"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}