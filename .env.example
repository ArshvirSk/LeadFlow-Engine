# ─── Database ────────────────────────────────────────────────────────────────
# Local:      postgresql://leadflow:leadflow@localhost:5432/leadflow
# Neon (prod): postgresql://<user>:<pass>@<host>.neon.tech/leadflow?sslmode=require
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local:       redis://localhost:6379
# Upstash (prod): rediss://:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/leads
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── LLM Providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=claude  # 'claude' | 'openai'

# ─── External APIs ───────────────────────────────────────────────────────────
CRUNCHBASE_API_KEY=...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=leadflow-engine/1.0
RESEND_API_KEY=re_...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── App URLs ────────────────────────────────────────────────────────────────
# Local
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Production (update after deploy)
# API_URL=https://leadflow-api.fly.dev
# NEXT_PUBLIC_API_URL=https://leadflow-api.fly.dev
# NEXT_PUBLIC_APP_URL=https://leadflow.vercel.app

# ─── Security ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=32-byte-hex-key-here
HMAC_SECRET=32-byte-hex-secret-here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
